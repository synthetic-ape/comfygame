   "widgets_values": [
    "# Every part is a node\n\nThis graph builds a platformer from parts. Swap any of them: connect **Sprite From Image** instead of a procedural sprite, use **Music From Audio** with any audio model, chain more **Enemy** nodes, add your own **Level From Text**.\n\nUnconnected palettes: procedural art is recoloured to the game palette automatically."
   ],
   "widgets_values_named": {
    "text": "# Every part is a node\n\nThis graph builds a platformer from parts. Swap any of them: connect **Sprite From Image** instead of a procedural sprite, use **Music From Audio** with any audio model, chain more **Enemy** nodes, add your own **Level From Text**.\n\nUnconnected palettes: procedural art is recoloured to the game palette automatically."
   },
   "color": "#432",
   "bgcolor": "#653"
  },
